    {
        "@id": "http://rdfs.org/ns/void#Dataset",
        "@type": [
            "http://www.w3.org/2000/01/rdf-schema#Class",
            "http://www.w3.org/2002/07/owl#Class"
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "dataset"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "A set of RDF triples that are published, maintained or aggregated by a single provider."
            }
        ]
    },
    {
        "@id": "http://rdfs.org/ns/void#DatasetDescription",
        "@type": [
            "http://www.w3.org/2000/01/rdf-schema#Class",
            "http://www.w3.org/2002/07/owl#Class"
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "dataset description"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "A web resource whose foaf:primaryTopic or foaf:topics include void:Datasets."
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
            {
                "@id": "http://xmlns.com/foaf/0.1/Document"
            }
        ]
    },
    {
        "@id": "http://rdfs.org/ns/void#Linkset",
        "@type": [
            "http://www.w3.org/2000/01/rdf-schema#Class",
            "http://www.w3.org/2002/07/owl#Class"
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "linkset"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "A collection of RDF links between two void:Datasets."
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
            {
                "@id": "http://rdfs.org/ns/void#Dataset"
            }
        ]
    },
    {
        "@id": "http://rdfs.org/ns/void#TechnicalFeature",
        "@type": [
            "http://www.w3.org/2000/01/rdf-schema#Class",
            "http://www.w3.org/2002/07/owl#Class"
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "technical feature"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "A technical feature of a void:Dataset, such as a supported RDF serialization format."
            }
        ]
    },
    {
        "@id": "http://rdfs.org/ns/void#class",
        "@type": [
            "http://www.w3.org/2002/07/owl#FunctionalProperty"
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "class"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "The rdfs:Class that is the rdf:type of all entities in a class-based partition."
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#domain": [
            {
                "@id": "http://rdfs.org/ns/void#Dataset"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#range": [
            {
                "@id": "http://www.w3.org/2000/01/rdf-schema#Class"
            }
        ]
    },
    {
        "@id": "http://rdfs.org/ns/void#classPartition",
        "@type": [
            "http://www.w3.org/2002/07/owl#ObjectProperty"
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "class partition"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "A subset of a void:Dataset that contains only the entities of a certain rdfs:Class."
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#domain": [
            {
                "@id": "http://rdfs.org/ns/void#Dataset"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#range": [
            {
                "@id": "http://rdfs.org/ns/void#Dataset"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
            {
                "@id": "http://rdfs.org/ns/void#subset"
            }
        ]
    },
    {
        "@id": "http://rdfs.org/ns/void#classes",
        "@type": [
            "http://www.w3.org/2002/07/owl#DatatypeProperty"
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "classes"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "The total number of distinct classes in a void:Dataset. In other words, the number of distinct resources occuring as objects of rdf:type triples in the dataset."
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#domain": [
            {
                "@id": "http://rdfs.org/ns/void#Dataset"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#range": [
            {
                "@id": "http://www.w3.org/2001/XMLSchema#integer"
            }
        ]
    },
    {
        "@id": "http://rdfs.org/ns/void#dataDump",
        "@type": [
            "http://www.w3.org/2002/07/owl#ObjectProperty"
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "Data Dump"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "An RDF dump, partial or complete, of a void:Dataset."
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#domain": [
            {
                "@id": "http://rdfs.org/ns/void#Dataset"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#range": [
            {
                "@id": "http://www.w3.org/2000/01/rdf-schema#Resource"
            }
        ]
    },
    {
        "@id": "http://rdfs.org/ns/void#distinctObjects",
        "@type": [
            "http://www.w3.org/2002/07/owl#DatatypeProperty"
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "distinct objects"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "The total number of distinct objects in a void:Dataset. In other words, the number of distinct resources that occur in the object position of triples in the dataset. Literals are included in this count."
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#domain": [
            {
                "@id": "http://rdfs.org/ns/void#Dataset"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#range": [
            {
                "@id": "http://www.w3.org/2001/XMLSchema#integer"
            }
        ]
    },
    {
        "@id": "http://rdfs.org/ns/void#distinctSubjects",
        "@type": [
            "http://www.w3.org/2002/07/owl#DatatypeProperty"
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "distinct subjects"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "The total number of distinct subjects in a void:Dataset. In other words, the number of distinct resources that occur in the subject position of triples in the dataset."
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#domain": [
            {
                "@id": "http://rdfs.org/ns/void#Dataset"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#range": [
            {
                "@id": "http://www.w3.org/2001/XMLSchema#integer"
            }
        ]
    },
    {
        "@id": "http://rdfs.org/ns/void#documents",
        "@type": [
            "http://www.w3.org/2002/07/owl#DatatypeProperty"
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "number of documents"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "The total number of documents, for datasets that are published as a set of individual documents, such as RDF/XML documents or RDFa-annotated web pages. Non-RDF documents, such as web pages in HTML or images, are usually not included in this count. This property is intended for datasets where the total number of triples or entities is hard to determine. void:triples or void:entities should be preferred where practical."
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#domain": [
            {
                "@id": "http://rdfs.org/ns/void#Dataset"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#range": [
            {
                "@id": "http://www.w3.org/2001/XMLSchema#integer"
            }
        ]
    },
    {
        "@id": "http://rdfs.org/ns/void#entities",
        "@type": [
            "http://www.w3.org/2002/07/owl#DatatypeProperty"
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "number of entities"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "The total number of entities that are described in a void:Dataset."
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#domain": [
            {
                "@id": "http://rdfs.org/ns/void#Dataset"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#range": [
            {
                "@id": "http://www.w3.org/2001/XMLSchema#integer"
            }
        ]
    },
