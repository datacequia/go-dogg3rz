    {
        "@id": "http://www.w3.org/ns/ssn/Property",
        "@type": [
            "http://www.w3.org/2002/07/owl#Class"
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "Property",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2004/02/skos/core#definition": [
            {
                "@value": "A quality of an entity. An aspect of an entity that is intrinsic to and cannot exist without the entity.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "A quality of an entity. An aspect of an entity that is intrinsic to and cannot exist without the entity.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
            {
                "@id": "_:b4"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/ssn/"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/ssn/Stimulus",
        "@type": [
            "http://www.w3.org/2002/07/owl#Class"
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "Stimulus",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2004/02/skos/core#definition": [
            {
                "@value": "An event in the real world that 'triggers' the Sensor. The properties associated to the Stimulus may be different to the eventual observed ObservableProperty. It is the event, not the object, that triggers the Sensor.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "An event in the real world that 'triggers' the Sensor. The properties associated to the Stimulus may be different to the eventual observed ObservableProperty. It is the event, not the object, that triggers the Sensor.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
            {
                "@id": "_:b76"
            },
            {
                "@id": "_:b77"
            },
            {
                "@id": "_:b78"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/ssn/"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/ssn/System",
        "@type": [
            "http://www.w3.org/2002/07/owl#Class"
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "System",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2004/02/skos/core#definition": [
            {
                "@value": "System is a unit of abstraction for pieces of infrastructure that implement Procedures. A System may have components, its subsystems, which are other systems.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "System is a unit of abstraction for pieces of infrastructure that implement Procedures. A System may have components, its subsystems, which are other systems.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
            {
                "@id": "_:b82"
            },
            {
                "@id": "_:b83"
            },
            {
                "@id": "_:b84"
            },
            {
                "@id": "_:b85"
            },
            {
                "@id": "_:b86"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/ssn/"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/ssn/deployedOnPlatform",
        "@type": [
            "http://www.w3.org/2002/07/owl#ObjectProperty"
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "deployed on platform",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2004/02/skos/core#definition": [
            {
                "@value": "Relation between a Deployment and the Platform on which the Systems are deployed.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "Relation between a Deployment and the Platform on which the Systems are deployed.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2002/07/owl#inverseOf": [
            {
                "@id": "http://www.w3.org/ns/ssn/inDeployment"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/ssn/"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/ssn/deployedSystem",
        "@type": [
            "http://www.w3.org/2002/07/owl#ObjectProperty"
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "deployed system",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2004/02/skos/core#definition": [
            {
                "@value": "Relation between a Deployment and a deployed System.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "Relation between a Deployment and a deployed System.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2002/07/owl#inverseOf": [
            {
                "@id": "http://www.w3.org/ns/ssn/hasDeployment"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/ssn/"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/ssn/detects",
        "@type": [
            "http://www.w3.org/2002/07/owl#ObjectProperty"
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "detects",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2004/02/skos/core#definition": [
            {
                "@value": "A relation from a Sensor to the Stimulus that the Sensor detects. The Stimulus itself will be serving as a proxy for some ObservableProperty.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "A relation from a Sensor to the Stimulus that the Sensor detects. The Stimulus itself will be serving as a proxy for some ObservableProperty.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/ssn/"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/ssn/forProperty",
        "@type": [
            "http://www.w3.org/2002/07/owl#ObjectProperty"
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "for property",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2004/02/skos/core#definition": [
            {
                "@value": "A relation between some aspect of an entity and a Property.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "A relation between some aspect of an entity and a Property.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2004/02/skos/core#example": [
            {
                "@value": "For example, from a Sensor to the properties it can observe; from an Actuator to the properties it can act on; from a Deployment to the properties it was installed to observe or act on; from a SystemCapability to the Property the capability is described for.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/ssn/"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/ssn/hasDeployment",
        "@type": [
            "http://www.w3.org/2002/07/owl#ObjectProperty"
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "has deployment",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2004/02/skos/core#definition": [
            {
                "@value": "Relation between a System and a Deployment, recording that the System is deployed in that Deployment.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "Relation between a System and a Deployment, recording that the System is deployed in that Deployment.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2002/07/owl#inverseOf": [
            {
                "@id": "http://www.w3.org/ns/ssn/deployedSystem"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/ssn/"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/ssn/hasInput",
        "@type": [
            "http://www.w3.org/2002/07/owl#ObjectProperty"
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "has input",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2004/02/skos/core#definition": [
            {
                "@value": "Relation between a Procedure and an Input to it.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "Relation between a Procedure and an Input to it.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/ssn/"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/ssn/hasOutput",
        "@type": [
            "http://www.w3.org/2002/07/owl#ObjectProperty"
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "has output",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2004/02/skos/core#definition": [
            {
                "@value": "Relation between a Procedure and an Output of it.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "Relation between a Procedure and an Output of it.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/ssn/"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/ssn/hasProperty",
        "@type": [
            "http://www.w3.org/2002/07/owl#ObjectProperty"
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "has property",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2004/02/skos/core#definition": [
            {
                "@value": "Relation between an entity and a Property of that entity.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "Relation between an entity and a Property of that entity.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2002/07/owl#inverseOf": [
            {
                "@id": "http://www.w3.org/ns/ssn/isPropertyOf"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/ssn/"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/ssn/hasSubSystem",
        "@type": [
            "http://www.w3.org/2002/07/owl#ObjectProperty"
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "has subsystem",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2004/02/skos/core#definition": [
            {
                "@value": "Relation between a System and its component parts.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "Relation between a System and its component parts.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/ssn/"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/ssn/implementedBy",
        "@type": [
            "http://www.w3.org/2002/07/owl#ObjectProperty"
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "implemented by",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2004/02/skos/core#definition": [
            {
                "@value": "Relation between a Procedure (an algorithm, procedure or method) and an entity that implements that Procedure in some executable way.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "Relation between a Procedure (an algorithm, procedure or method) and an entity that implements that Procedure in some executable way.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2004/02/skos/core#example": [
            {
                "@value": "For example, the relationship between a scientific measuring Procedure and a sensor that senses via that Procedure.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2002/07/owl#inverseOf": [
            {
                "@id": "http://www.w3.org/ns/ssn/implements"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/ssn/"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/ssn/implements",
        "@type": [
            "http://www.w3.org/2002/07/owl#ObjectProperty"
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "implements",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2004/02/skos/core#definition": [
            {
                "@value": "Relation between an entity that implements a Procedure in some executable way and the Procedure (an algorithm, procedure or method).",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "Relation between an entity that implements a Procedure in some executable way and the Procedure (an algorithm, procedure or method).",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2004/02/skos/core#example": [
            {
                "@value": "For example, the relationship between a sensor and the scientific measuring Procedure via which it senses.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2002/07/owl#inverseOf": [
            {
                "@id": "http://www.w3.org/ns/ssn/implementedBy"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/ssn/"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/ssn/inDeployment",
        "@type": [
            "http://www.w3.org/2002/07/owl#ObjectProperty"
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "in deployment",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2004/02/skos/core#definition": [
            {
                "@value": "Relation between a Platform and a Deployment, meaning that the deployedSystems of the Deployment are hosted on the Platform.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "Relation between a Platform and a Deployment, meaning that the deployedSystems of the Deployment are hosted on the Platform.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2004/02/skos/core#example": [
            {
                "@value": "For example, a relation between a buoy and a deployment of several Sensors.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2002/07/owl#inverseOf": [
            {
                "@id": "http://www.w3.org/ns/ssn/deployedOnPlatform"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/ssn/"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/ssn/isPropertyOf",
        "@type": [
            "http://www.w3.org/2002/07/owl#ObjectProperty"
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "is property of",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2004/02/skos/core#definition": [
            {
                "@value": "Relation between a Property and the entity it belongs to.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "Relation between a Property and the entity it belongs to.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2002/07/owl#inverseOf": [
            {
                "@id": "http://www.w3.org/ns/ssn/hasProperty"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/ssn/"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/ssn/isProxyFor",
        "@type": [
            "http://www.w3.org/2002/07/owl#ObjectProperty"
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "is proxy for",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2004/02/skos/core#definition": [
            {
                "@value": "A relation from a Stimulus to the Property that the Stimulus is serving as a proxy for.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "A relation from a Stimulus to the Property that the Stimulus is serving as a proxy for.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2004/02/skos/core#example": [
            {
                "@value": "For example, the expansion of quicksilver is a stimulus that serves as a proxy for some temperature property. An increase or decrease in the velocity of spinning cups on a wind sensor is serving as a proxy for the wind speed.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/ssn/"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/ssn/wasOriginatedBy",
        "@type": [
            "http://www.w3.org/2002/07/owl#ObjectProperty",
            "http://www.w3.org/2002/07/owl#FunctionalProperty"
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "was originated by",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2004/02/skos/core#definition": [
            {
                "@value": "Relation between an Observation and the Stimulus that originated it.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "Relation between an Observation and the Stimulus that originated it.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/ssn/"
            }
        ]
    },
