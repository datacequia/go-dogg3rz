    {
        "@id": "http://www.w3.org/ns/ssn/",
        "@type": [
            "http://www.w3.org/2002/07/owl#Ontology",
            "http://purl.org/vocommons/voaf#Vocabulary"
        ],
        "http://purl.org/dc/terms/title": [
            {
                "@value": "Semantic Sensor Network Ontology",
                "@language": "en"
            }
        ],
        "http://purl.org/dc/terms/description": [
            {
                "@value": "This ontology describes sensors, actuators and observations, and related concepts. It does not describe domain concepts, time, locations, etc. these are intended to be included from other ontologies via OWL imports.",
                "@language": "en"
            }
        ],
        "http://purl.org/dc/terms/creator": [
            {
                "@id": "_:b0"
            }
        ],
        "http://purl.org/dc/terms/rights": [
            {
                "@value": "Copyright 2017 W3C/OGC."
            }
        ],
        "http://purl.org/dc/terms/license": [
            {
                "@id": "http://www.w3.org/Consortium/Legal/2015/copyright-software-and-document"
            },
            {
                "@id": "http://www.opengeospatial.org/ogc/Software"
            }
        ],
        "http://www.w3.org/2002/07/owl#versionInfo": [
            {
                "@value": "New modular version of the SSN ontology. \n\nThis ontology was originally developed in 2009-2011 by the W3C Semantic Sensor Networks Incubator Group (SSN-XG). For more information on the group's activities see: http://www.w3.org/2005/Incubator/ssn/. The ontology was revised and modularized in 2015-2017 by the W3C/OGC Spatial Data on the Web Working Group, see: https://www.w3.org/2015/spatial/wiki/Semantic_Sensor_Network_Ontology. \n\nIn particular, (a) the scope is extended to include actuation and sampling; (b) the core concepts and properties are factored out into the SOSA ontology. The SSN ontology imports SOSA and adds formal axiomatization consistent with the text definitions in SOSA, and adds classes and properties to accommodate the scope of the original SSN ontology. ",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "Please report any errors to the W3C Spatial Data on the Web Working Group via the SDW WG Public List public-sdw-wg@w3.org",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
            {
                "@id": "https://www.w3.org/2015/spatial/wiki/Semantic_Sensor_Network_Ontology"
            }
        ],
        "http://purl.org/dc/terms/created": [
            {
                "@value": "2017-04-17",
                "@type": "http://www.w3.org/2001/XMLSchema#date"
            }
        ],
        "http://purl.org/vocab/vann/preferredNamespacePrefix": [
            {
                "@value": "ssn"
            }
        ],
        "http://purl.org/vocab/vann/preferredNamespaceUri": [
            {
                "@value": "http://www.w3.org/ns/ssn/"
            }
        ],
        "http://www.w3.org/2002/07/owl#imports": [
            {
                "@id": "http://www.w3.org/ns/sosa/"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/ssn/Deployment",
        "@type": [
            "http://www.w3.org/2002/07/owl#Class"
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "Deployment",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2004/02/skos/core#definition": [
            {
                "@value": "Describes the Deployment of one or more Systems for a particular purpose. Deployment may be done on a Platform.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "Describes the Deployment of one or more Systems for a particular purpose. Deployment may be done on a Platform.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2004/02/skos/core#example": [
            {
                "@value": "For example, a temperature Sensor deployed on a wall, or a whole network of Sensors deployed for an Observation campaign.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
            {
                "@id": "_:b88"
            },
            {
                "@id": "_:b89"
            },
            {
                "@id": "_:b90"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/ssn/"
            }
        ]
    },
