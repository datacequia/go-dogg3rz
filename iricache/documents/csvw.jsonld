        "@type": [
            "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "An atomic property that, if the boolean `true`, sets the trim flag to `true` and if the boolean `false` to `false`. If the value provided is a string, sets the trim flag to the provided value, which must be one of \"true\", \"false\", \"start\" or \"end\".",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#domain": [
            {
                "@id": "http://www.w3.org/ns/csvw#Dialect"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "trim",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#range": [
            {
                "@id": "http://www.w3.org/2001/XMLSchema#boolean"
            }
        ]
    },
