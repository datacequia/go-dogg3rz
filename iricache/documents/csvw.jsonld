            "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "An object property that identifies a **referenced table** and a set of **referenced columns** within that table.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#domain": [
            {
                "@id": "http://www.w3.org/ns/csvw#ForeignKey"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "reference",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#range": [
            {
                "@id": "http://www.w3.org/ns/csvw#TableReference"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/csvw#referencedRow",
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/csvw#"
