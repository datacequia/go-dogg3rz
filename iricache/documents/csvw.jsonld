        "http://www.w3.org/2000/01/rdf-schema#range": [
            {
                "@id": "http://www.w3.org/2001/XMLSchema#string"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/csvw#primaryKey",
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/csvw#"
            }
        ],
        "@type": [
            "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "For Schema: A column reference property that holds either a single reference to a column description object or an array of references.\n\nFor Row: a possibly empty list of cells whose values together provide a unique identifier for this row. This is similar to the name of a column.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#domain": [
            {
                "@id": "_:b45"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "primary key",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#range": [
            {
                "@id": "http://www.w3.org/2001/XMLSchema#string"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/csvw#propertyUrl",
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/csvw#"
            }
        ],
        "@type": [
            "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "An URI template property that MAY be used to create a URI for a property if the table is mapped to another format. ",
