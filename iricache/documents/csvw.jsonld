        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "A Transformation Definition is a definition of how tabular data can be transformed into another format.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "Transformation Definition",
                "@language": "en"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/csvw#aboutUrl",
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/csvw#"
            }
        ],
        "@type": [
            "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "A URI template property that MAY be used to indicate what a cell contains information about.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#domain": [
            {
                "@id": "_:b0"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "about URL",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#range": [
            {
                "@id": "http://www.w3.org/ns/csvw#uriTemplate"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/csvw#auto",
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/csvw#"
            }
        ],
        "@type": [
            "http://www.w3.org/ns/csvw#Direction"
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "Indicates whether the tables in the group should be displayed based on the first character in the table that has a specific direction.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "auto",
                "@language": "en"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/csvw#base",
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/csvw#"
            }
        ],
        "@type": [
            "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "An atomic property that contains a single string: a term defined in the default context representing a built-in datatype URL, as listed above.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#domain": [
            {
                "@id": "http://www.w3.org/ns/csvw#Datatype"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "base",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#range": [
            {
                "@id": "http://www.w3.org/2001/XMLSchema#string"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/csvw#column",
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/csvw#"
            }
        ],
        "@type": [
            "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "An array property of column descriptions as described in section 5.6 Columns.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#domain": [
            {
                "@id": "http://www.w3.org/ns/csvw#Schema"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "column",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#range": [
            {
                "@id": "http://www.w3.org/ns/csvw#Column"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/csvw#columnReference",
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/csvw#"
            }
        ],
        "@type": [
            "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "A column reference property that holds either a single reference to a column description object within this schema, or an array of references. These form the referencing columns for the foreign key definition.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#domain": [
            {
                "@id": "_:b5"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "column reference",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#range": [
            {
                "@id": "http://www.w3.org/2001/XMLSchema#string"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/csvw#commentPrefix",
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/csvw#"
            }
        ],
        "@type": [
            "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "An atomic property that sets the comment prefix flag to the single provided value, which MUST be a string.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#domain": [
            {
                "@id": "http://www.w3.org/ns/csvw#Dialect"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "comment prefix",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#range": [
            {
                "@id": "http://www.w3.org/2001/XMLSchema#string"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/csvw#csvEncodedTabularData",
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/csvw#"
            }
        ],
        "@type": [
            "http://www.w3.org/ns/prov#Role"
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "Describes the role of a CSV file in the tabular data mapping.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "CSV Encoded Tabular Data",
                "@language": "en"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/csvw#datatype",
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/csvw#"
            }
        ],
        "@type": [
            "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "An object property that contains either a single string that is the main datatype of the values of the cell or a datatype description object. If the value of this property is a string, it MUST be one of the built-in datatypes defined in section 5.11.1 Built-in Datatypes or an absolute URL; if it is an object then it describes a more specialised datatype.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#domain": [
            {
                "@id": "_:b8"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "datatype",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#range": [
            {
                "@id": "_:b9"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/csvw#decimalChar",
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/csvw#"
            }
        ],
        "@type": [
            "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "A string whose value is used to represent a decimal point within the number.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#domain": [
            {
                "@id": "http://www.w3.org/ns/csvw#NumericFormat"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "decimal character",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#range": [
            {
                "@id": "http://www.w3.org/2001/XMLSchema#string"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/csvw#default",
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/csvw#"
            }
        ],
        "@type": [
            "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "An atomic property holding a single string that is used to create a default value for the cell in cases where the original string value is an empty string.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#domain": [
            {
                "@id": "_:b16"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "default",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#range": [
            {
                "@id": "http://www.w3.org/2001/XMLSchema#string"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/csvw#delimiter",
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/csvw#"
            }
        ],
        "@type": [
            "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "An atomic property that sets the delimiter flag to the single provided value, which MUST be a string.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#domain": [
            {
                "@id": "http://www.w3.org/ns/csvw#Dialect"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "delimiter",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#range": [
            {
                "@id": "http://www.w3.org/2001/XMLSchema#string"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/csvw#describes",
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/csvw#"
            }
        ],
        "@type": [
            "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "From IANA describes: The relationship A 'describes' B asserts that resource A provides a description of resource B. There are no constraints on the format or representation of either A or B, neither are there any further constraints on either resource.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#domain": [
            {
                "@id": "http://www.w3.org/ns/csvw#Row"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "describes",
                "@language": "en"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/csvw#dialect",
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/csvw#"
            }
        ],
        "@type": [
            "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "An object property that provides a single dialect description. If provided, dialect provides hints to processors about how to parse the referenced files to create tabular data models for the tables in the group.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#domain": [
            {
                "@id": "_:b21"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "dialect",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#range": [
            {
                "@id": "http://www.w3.org/ns/csvw#Dialect"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/csvw#doubleQuote",
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/csvw#"
            }
        ],
        "@type": [
            "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "A boolean atomic property that, if `true`, sets the escape character flag to `\"`.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#domain": [
            {
                "@id": "http://www.w3.org/ns/csvw#Dialect"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "double quote",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#range": [
            {
                "@id": "http://www.w3.org/2001/XMLSchema#boolean"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/csvw#encoding",
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/csvw#"
            }
        ],
        "@type": [
            "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "An atomic property that sets the encoding flag to the single provided string value, which MUST be a defined in [[encoding]]. The default is \"utf-8\".",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#domain": [
            {
                "@id": "http://www.w3.org/ns/csvw#Dialect"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "encoding",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#range": [
            {
                "@id": "http://www.w3.org/2001/XMLSchema#string"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/csvw#foreignKey",
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/csvw#"
            }
        ],
        "@type": [
            "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "For a Table: a list of foreign keys on the table.\n\nFor a Schema: an array property of foreign key definitions that define how the values from specified columns within this table link to rows within this table or other tables.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#domain": [
            {
                "@id": "_:b24"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "foreign key",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#range": [
            {
                "@id": "http://www.w3.org/ns/csvw#ForeignKey"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/csvw#format",
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/csvw#"
            }
        ],
        "@type": [
            "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "An atomic property that contains either a single string or an object that defines the format of a value of this type, used when parsing a string value as described in Parsing Cells in [[tabular-data-model]].",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#domain": [
            {
                "@id": "http://www.w3.org/ns/csvw#Datatype"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "format",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#range": [
            {
                "@id": "http://www.w3.org/2001/XMLSchema#string"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/csvw#groupChar",
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/csvw#"
            }
        ],
        "@type": [
            "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "A string whose value is used to group digits within the number.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#domain": [
            {
                "@id": "http://www.w3.org/ns/csvw#NumericFormat"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "group character",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#range": [
            {
                "@id": "http://www.w3.org/2001/XMLSchema#string"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/csvw#header",
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/csvw#"
            }
        ],
        "@type": [
            "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "A boolean atomic property that, if `true`, sets the header row count flag to `1`, and if `false` to `0`, unless headerRowCount is provided, in which case the value provided for the header property is ignored.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#domain": [
            {
                "@id": "http://www.w3.org/ns/csvw#Dialect"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "header",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#range": [
            {
                "@id": "http://www.w3.org/2001/XMLSchema#boolean"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/csvw#headerRowCount",
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/csvw#"
            }
        ],
        "@type": [
            "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "An numeric atomic property that sets the header row count flag to the single provided value, which must be a non-negative integer.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#domain": [
            {
                "@id": "http://www.w3.org/ns/csvw#Dialect"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "header row count",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#range": [
            {
                "@id": "http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/csvw#inherit",
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/csvw#"
            }
        ],
        "@type": [
            "http://www.w3.org/ns/csvw#Direction"
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "For `textDirection`, indicates that the direction is inherited from the `tableDirection` annotation of the `table`.",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "inherit",
                "@language": "en"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/csvw#lang",
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/csvw#"
            }
        ],
