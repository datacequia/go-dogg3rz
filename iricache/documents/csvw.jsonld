            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#domain": [
            {
                "@id": "_:b48"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#label": [
            {
                "@value": "property URL",
                "@language": "en"
            }
        ],
        "http://www.w3.org/2000/01/rdf-schema#range": [
            {
                "@id": "http://www.w3.org/ns/csvw#uriTemplate"
            }
        ]
    },
    {
        "@id": "http://www.w3.org/ns/csvw#quoteChar",
        "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
            {
                "@id": "http://www.w3.org/ns/csvw#"
            }
        ],
        "@type": [
            "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "An atomic property that sets the quote character flag to the single provided value, which must be a string or `null`.",
