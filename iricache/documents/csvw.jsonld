            {
                "@id": "http://www.w3.org/ns/csvw#"
            }
        ],
        "@type": [
            "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "A boolean atomic property taking a single value which indicates whether the cell must have a non-null value. The default is `false`. ",
                "@language": "en"
