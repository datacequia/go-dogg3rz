        ],
        "http://www.w3.org/2000/01/rdf-schema#comment": [
            {
                "@value": "For a Table: This link property gives the single URL of the CSV file that the table is held in, relative to the location of the metadata document.\n\nFor a Transformation: A link property giving the single URL of the file that the script or template is held in, relative to the location of the metadata document.",
