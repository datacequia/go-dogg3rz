    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A circuit breaker is a safety device to prevent damage to devices in a circuit, such as electric motors, and wiring when the current flowing through the electrical circuit supersedes its design limits. It does this by removing the current from a circuit when an unsafe condition arises. Unlike a switch, a circuit breaker automatically does this and shuts off the power immediately."
      }
    ],
