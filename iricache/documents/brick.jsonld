    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n          SELECT ?this\n          WHERE {\n            ?this rdfs:subClassOf+ brick:Sensor .\n            FILTER NOT EXISTS { ?class owl:deprecated true }\n          }\n        "
      }
    ]
  },
  {
