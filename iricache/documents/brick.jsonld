  {
    "@id": "https://brickschema.org/schema/BrickShape#TimeseriesReferenceOnPointsConstraint",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/ns/shacl#sparql": [
      {
        "@id": "_:nb620c5603de84dce9ab98f90e7e4ecaeb4303"
      }
    ],
    "http://www.w3.org/ns/shacl#targetSubjectsOf": [
      {
        "@id": "https://brickschema.org/schema/Brick/ref#hasExternalReference"
      }
    ]
  },
  {
    "@id": "_:nb620c5603de84dce9ab98f90e7e4ecaeb4303",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLConstraint"
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Only Brick Points can have external timeseries references"
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://brickschema.org/schema/1.4/Brick"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            SELECT $this\n            WHERE {\n                $this ref:hasExternalReference ?ref .\n                ?ref rdf:type ref:TimeseriesReference .\n                FILTER NOT EXISTS { $this rdf:type/rdfs:subClassOf* brick:Point }\n            }\n        "
      }
    ]
  },
