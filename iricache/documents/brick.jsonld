  {
    "@id": "https://brickschema.org/schema/BrickShape#CollectionIncludesEquipment",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/ns/shacl#rule": [
      {
        "@id": "_:nb620c5603de84dce9ab98f90e7e4ecaeb3659"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://brickschema.org/schema/Brick#Collection"
      },
      {
        "@id": "https://brickschema.org/schema/Brick#Equipment"
      },
      {
        "@id": "https://brickschema.org/schema/Brick#System"
      }
    ]
  },
  {
    "@id": "_:nb620c5603de84dce9ab98f90e7e4ecaeb3659",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLRule"
    ],
    "http://www.w3.org/ns/shacl#construct": [
      {
        "@value": "\n        CONSTRUCT {\n            $this rec:includes ?eq .\n        }\n        WHERE {\n            $this brick:hasPart ?eq .\n            {\n                ?eq rdf:type/rdfs:subClassOf* brick:Equipment .\n            }\n            UNION\n            {\n                ?eq rdf:type/rdfs:subClassOf* brick:Collection .\n            }\n            UNION\n            {\n                ?eq rdf:type/rdfs:subClassOf* brick:System .\n            }\n        }\n        "
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://brickschema.org/schema/1.4/Brick"
      }
    ]
  },
