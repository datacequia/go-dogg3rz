  {
    "@id": "_:nb620c5603de84dce9ab98f90e7e4ecaeb3932",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLRule"
    ],
    "http://www.w3.org/ns/shacl#construct": [
      {
        "@value": "\n        CONSTRUCT {\n            $this rdf:type ?metertype .\n        } WHERE {\n            $this rdf:type/rdfs:subClassOf* brick:Building_Meter .\n            $this brick:hasSubstance ?substance .\n            ?metertype brick:hasSubstance ?substance .\n            ?metertype rdfs:subClassOf+ brick:Building_Meter .\n        }\n        "
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
