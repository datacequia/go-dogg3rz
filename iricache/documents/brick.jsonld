    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLRule"
    ],
    "http://www.w3.org/ns/shacl#construct": [
      {
        "@value": "\nCONSTRUCT {\n    ?s ?t2 ?o .\n} WHERE {\n    ?s $this ?o .\n    { $this owl:equivalentProperty ?t2 }\n    UNION\n    { ?t2 owl:equivalentProperty $this }\n}"
      }
    ],
