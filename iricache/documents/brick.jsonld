      }
    ]
  },
  {
    "@id": "_:nb620c5603de84dce9ab98f90e7e4ecaeb1005",
    "@type": [
      "http://www.w3.org/ns/shacl#PropertyShape"
    ],
    "http://www.w3.org/ns/shacl#in": [
      {
        "@list": [
          {
            "@value": "Level 1"
          },
          {
            "@value": "Level 2"
          },
          {
