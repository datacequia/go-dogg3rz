    "http://www.w3.org/ns/shacl#construct": [
      {
        "@value": "\nCONSTRUCT {\n?o ?prop $this .\n$this ?prop ?o .\n}\nWHERE {\n  { $this ?prop ?o } UNION { ?o ?prop $this } .\n  ?prop a owl:SymmetricProperty .\n}\n\t\t\t"
      }
