      }
    ]
  },
  {
    "@id": "https://brickschema.org/schema/BrickShape#RDFSSubPropertyOfRuleForEntityProperties",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/ns/shacl#rule": [
      {
        "@id": "_:nb620c5603de84dce9ab98f90e7e4ecaeb4089"
      }
    ],
    "http://www.w3.org/ns/shacl#targetSubjectsOf": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#subPropertyOf"
      }
    ]
  },
  {
    "@id": "_:nb620c5603de84dce9ab98f90e7e4ecaeb4089",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLRule"
    ],
    "http://www.w3.org/ns/shacl#construct": [
      {
        "@value": "\n            CONSTRUCT {\n                ?s ?super ?skolemized .\n                ?skolemized ?ep ?eo .\n            } WHERE {\n                $this rdfs:subPropertyOf+ ?super .\n                ?super a brick:EntityProperty .\n                $this a brick:EntityProperty .\n                ?s $this ?o .\n                BIND(IF(isBlank(?o), IRI(CONCAT(\"urn:skolem:\", STRUUID())), ?o) AS ?skolemized)\n                ?o ?ep ?eo .\n            }\n        "
      }
    ],
