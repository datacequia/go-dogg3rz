  },
  {
    "@id": "_:nb620c5603de84dce9ab98f90e7e4ecaeb4369",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLConstraint"
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "Only meters can have the isVirtualMeter property be true"
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://brickschema.org/schema/1.4/Brick"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            SELECT $this WHERE {\n                $this brick:isVirtualMeter/brick:value true .\n                FILTER NOT EXISTS { $this rdf:type/rdfs:subClassOf* brick:Meter } .\n            }\n        "
      }
    ]
  },
