      "https://brickschema.org/schema/Brick#Substance"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Supply Air"
      }
    ],
    "http://www.w3.org/2002/07/owl#sameAs": [
      {
        "@id": "https://brickschema.org/schema/Brick#Discharge_Air"
